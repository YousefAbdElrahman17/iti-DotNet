@model GenAiDay2.Models.ChatViewModel

<div class="chatbot-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="text-center mb-4">
                    <div class="chatbot-icon">📄🤖</div>
                    <h2 class="fw-bold mb-1">PDF ChatBot</h2>
                    <p class="text-muted">Upload a pdf file and ask the AI about it</p>
                </div>

                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <form asp-action="Ask" method="post" enctype="multipart/form-data" id="chatForm">

                            <div class="mb-3">
                                <label asp-for="PdfFile" class="form-label fw-semibold">
                                    <i class="bi bi-file-earmark-pdf"></i> Upload a Pdf File
                                </label>
                                <input asp-for="PdfFile" type="file" accept=".pdf" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Question" class="form-label fw-semibold">
                                    Write the Question Here
                                </label>
                                <textarea asp-for="Question" class="form-control" rows="3"
                                          placeholder="Write your Question about the file here..."></textarea>
                            </div>

                            <button type="submit" id="askBtn" class="btn btn-primary w-100 py-2 fw-semibold rounded-3">
                                <span id="btnText">Ask AI</span>
                                <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                            </button>
                        </form>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model?.Answer))
                {
                    <div class="card border-0 shadow-sm rounded-4 mt-4 answer-card">
                        <div class="card-body p-4">
                            <h6 class="text-uppercase text-muted small fw-bold mb-2">
                                <i class="bi bi-stars"></i> AI Answer
                            </h6>
                            <p class="mb-0 fs-5">@Model.Answer</p>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    .chatbot-wrapper {
        min-height: 90vh;
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
    }

    .chatbot-icon {
        font-size: 2.5rem;
    }

    .card {
        background: #ffffff;
    }

    .form-control {
        border-radius: 0.6rem;
        border-color: #dee2e6;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.15);
    }

    #askBtn {
        background: #6366f1;
        border: none;
        transition: background 0.2s ease;
    }

    #askBtn:hover {
        background: #4f46e5;
    }

    .answer-card {
        border-inline-start: 4px solid #6366f1 !important;
        background: #f9fafb;
        animation: fadeIn 0.35s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    document.getElementById('chatForm').addEventListener('submit', function () {
        document.getElementById('askBtn').setAttribute('disabled', 'true');
        document.getElementById('btnText').textContent = 'Thinking...';
        document.getElementById('btnSpinner').classList.remove('d-none');
    });
</script>