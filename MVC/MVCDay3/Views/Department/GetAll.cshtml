<h1>GetAll</h1>

@{
    List<Department>? depts = ViewBag.Depts as List<Department>;
}

<a href="/Department/Create/" class="btn btn-success">Create</a>

<table class="table table-striped">
    <tr>
        <th>Department Name</th>
        <th></th>
    </tr>

    @foreach (var dept in depts)
    {
        <tr>
            <td>@dept.Name</td>
            <td>
                <a href="/Department/Details/@dept.DeptId" class="btn btn-info">Details</a>
                <a href="/Department/Edit/@dept.DeptId" class="btn btn-warning">Edit</a>
            </td>
        </tr>
    }
</table>