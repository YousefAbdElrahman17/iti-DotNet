


<h1>Create new student</h1>

<form method="post" action="/Student/Create">
  <div class="mb-3">
    <label for="Sname" class="form-label">Name</label>
    <input type="text" class="form-control" name="Name" value="" id="Sname">

    <label for="age" class="form-label">Age</label>
    <input type="number" class="form-control" name="Age" value="" id="age">

    <label for="addr" class="form-label">Address</label>
    <input type="text" class="form-control" name="Address" value="" id="addr">

    <label for="dept" class="form-label">DeptID</label>
    <input type="number" class="form-control" name="DeptId" value="" id="dept">

    <input type="submit" value="Add" class=" btn btn-primary"></input>
    <a href="/Student/GetAll" class=" btn btn-primary">Cancel</a>
  </div>
</form>