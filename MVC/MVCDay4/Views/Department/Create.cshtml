@using MVCDay4.ViewModels
@model AddDepartmentViewModel

<h1>Create new department</h1>

<form method="post" action="/Department/Create">
  <div class="mb-3">
    <label for="dname" class="form-label">Department Name</label>
    <input type="text" class="form-control" name="Name" value="" id="dname">

    <input type="submit" value="Add" class=" btn btn-primary"></input>
    <a href="/Department/GetAll" class=" btn btn-primary">Cancel</a>
  </div>
</form>