@using MVCDay4.ViewModels
@model AddDepartmentViewModel

<h1>Edit</h1>
<form method="post" action="/Department/Edit">
  <div class="mb-3">

    <input type="hidden" name="DeptId" value="@Model.DeptId">

    <label for="dname" class="form-label">Department Name</label>
    <input type="text" class="form-control" name="Name" value="@Model.Name" id="dname">

    <input type="submit" value="Edit" class=" btn btn-primary"></input>
    <a href="/Department/GetAll" class=" btn btn-primary">Cancel</a>

  </div>
</form>