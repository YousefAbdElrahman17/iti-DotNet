

<h1>Create new employee</h1>


 <form method="post" action="/Employee/Create"> 
  <div class="mb-3">
    <label for="Ename" class="form-label">Name</label>
        <input type="text" class="form-control" name="Name" value="" id="Ename" >
    
        <label for="mohamed" class="form-label">Age</label>
        <input type="number" class="form-control" name="Age" value="" id="mohamed">

        <label for="E" class="form-label">Salary</label>
        <input type="number" class="form-control" name="Salary" value="" id="E">

        <label for="i" class="form-label">DeptID</label>
