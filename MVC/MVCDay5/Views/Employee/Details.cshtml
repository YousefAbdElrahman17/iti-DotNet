


@model  Employee
<h1>Details</h1>
<div class="card" style="width: 18rem;">
    <div class="card-body">
        <h5 class="card-title">Employee details</h5>
        <h2>@Model.Id</h2>
        <h2>@Model.Name</h2>
        <h2>@Model.Age</h2>
        <h2>@Model.Salary</h2>
        <h2>@Model.Department.Name</h2>

        <a href="/" class="btn btn-primary">Back</a>
    </div>
</div> 


