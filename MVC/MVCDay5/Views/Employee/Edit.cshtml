
<h1>Edit</h1>
@model Employee
<form method="post" action="/Employee/Edit">
    <div class="mb-3">

        
        <input type="hidden"  name="Id" value="@Model.Id">

        <label for="Ename" class="form-label">Name</label>
        <input type="text" class="form-control" name="Name" value="@Model.Name" id="Ename">

        <label for="mohamed" class="form-label">Age</label>
        <input type="number" class="form-control" name="Age" value="@Model.Age" id="mohamed">

        <label for="E" class="form-label">Salary</label>
        <input type="number" class="form-control" name="Salary" value="@Model.Salary" id="E">

        <label for="i" class="form-label">DeptID</label>
        <input type="number" class="form-control" name="DeptId" value="@Model.DeptId" id="i">


        <input type="submit" value="Edit" class=" btn btn-primary"></input>
        <a href="/Employee/GetAll" class=" btn btn-primary">Cancel</a>


    </div>
</form>