@using MVCDay5.ViewModels
@model EditStudentViewModel

<h1>Edit</h1>

@using (Html.BeginForm("Edit", "Student", FormMethod.Post))
{
    <div class="mb-3">

        @Html.HiddenFor(m => m.Id)

        @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })

        @Html.LabelFor(m => m.Age, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Age, new { @class = "form-control" })

        @Html.LabelFor(m => m.Address, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })

        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })

        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })

        @Html.LabelFor(m => m.DepartmentName, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.DepartmentName, new SelectList(Model.Departments, "DeptId", "Name"), new { @class = "form-control" })

        <input type="submit" value="Edit" class="btn btn-primary">
        <a asp-action="GetAll" asp-controller="Student" class="btn btn-primary">Cancel</a>

    </div>
}