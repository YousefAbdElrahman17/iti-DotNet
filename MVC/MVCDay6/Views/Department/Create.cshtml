@using MVCDay6.ViewModels
@model AddDepartmentViewModel

<h1>Create new department</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" asp-controller="Department" method="post">
  <div class="mb-3">
    <label asp-for="Name" class="form-label">Department Name</label>
    <input asp-for="Name" class="form-control">
    <span asp-validation-for="Name" class="text-danger"></span>
   </div> 

  <div class="mb-3">
    <input type="submit" value="Add" class="btn btn-primary">
    <a asp-action="GetAll" asp-controller="Department" class="btn btn-primary">Cancel</a>
  </div>
     
</form>
 @section Scripts {
    <partial name="_ValidationScriptsPartial" />
    }
    