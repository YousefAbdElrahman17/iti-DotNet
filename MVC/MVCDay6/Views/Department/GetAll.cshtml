@using MVCDay6.ViewModels
@model GetAllDepartmentsViewModel

<h1>GetAll</h1>
@if (!string.IsNullOrEmpty(ViewBag.LastViewedDeptName))
{
    <div class="alert alert-info">
        Last department you viewed: <strong>@ViewBag.LastViewedDeptName</strong>
    </div>
}
<p class="text-muted">You've visited this page <strong>@ViewBag.VisitCount</strong> time(s).</p>

<a asp-action="Create" asp-controller="Department" class="btn btn-success">Create</a>

<table class="table table-striped">
    <tr>
        <th>Id</th>
        <th>Department Name</th>
        <th></th>
    </tr>

    @foreach (var dept in Model.Departments)
    {
        <tr>
            <td>@dept.DeptId</td>
            <td>@dept.Name</td>
            <td>
                <a asp-action="Details" asp-controller="Department" asp-route-id="@dept.DeptId" class="btn btn-info">Details</a>
                <a asp-action="Edit" asp-controller="Department" asp-route-id="@dept.DeptId" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-controller="Department" asp-route-id="@dept.DeptId" class="btn btn-danger" onclick="return confirm('are you sure to delete department id @dept.DeptId')">Delete</a>
            </td>
        </tr>
    }
</table>